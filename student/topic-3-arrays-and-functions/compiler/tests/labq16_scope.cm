/* Expected output: 11  5 */
int add(int a, int b) {
    int result;
    result = a + b;
    return result;
}

int subtract(int a, int b) {
    int result;
    result = a - b;
    return result;
}

int main() {
    int x;
    int y;
    x = add(8, 3);
    y = subtract(8, 3);
    print(x);
    print(y);
    return 0;
}
